# Copy to local.env next to the E1 sbatch files on the cluster ($CE_ROOT/code/e1; local.env is
# gitignored) and replace each <...> with your own value. The sbatch scripts read it from the folder
# you submit from; submit with `. ./local.env && sbatch ...` so sbatch also sees SBATCH_ACCOUNT.
# Check the result without submitting: CE_DRY_RUN=1 bash normalize.sbatch
export SBATCH_ACCOUNT="<your-slurm-allocation>"
export CE_ROOT="/projects/<your-project>/citation-equity"
export CE_PYTHON="/projects/<your-project>/conda_envs/<env-with-vllm>/bin/python"
export HF_HOME="<your-scratch-folder>/hf"
# Optional, edit.sbatch only: a Node 22 or newer binary for the engine bridge, when `node` on the
# compute node's PATH is missing or older (or load a Node module through CE_MODULES instead).
# export CE_NODE="/projects/<your-project>/node-v22/bin/node"
# Optional: NVIDIA's forward-compat libcuda, when the env's torch needs a newer CUDA than the driver.
# export CE_CUDA_COMPAT="/projects/<your-project>/cuda-compat/usr/local/cuda-13.0/compat"
# Optional: modules to load first (default miniconda3/24.11.1; set to "" to load none).
# export CE_MODULES="miniconda3/24.11.1 <your-node-22-module>"
# Optional: job logs under $CE_ROOT/logs (create the folder first) instead of the submit folder.
# export SBATCH_OUTPUT="$CE_ROOT/logs/%x-%j.out" SBATCH_ERROR="$CE_ROOT/logs/%x-%j.err"
